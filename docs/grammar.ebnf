(*
  Coordination grammar.

  This file tracks the implemented lexer/parser:
    libs/coord/src/lexer.cpp
    libs/coord/src/parser.cpp
  If this grammar and the parser disagree, the parser is authoritative and
  this file is corrected. There is no inline grammar in framework.md.

  Notation: ISO/IEC 14977 EBNF.
    { x }       zero or more
    [ x ]       optional
    ( x | y )   alternative
    (* ... *)   comment
    ? ... ?     implementation-defined special sequence

  Implemented status:
  - `switch`, `match`, `for ... in`, lambdas, method references, `@Unsafe`,
    `@Safe`, `@Retention(Compile|Runtime)` blocks and `@Lock` blocks parse.
  - `T?` is NOT implemented: `?` is not accepted in type position.
  - There is no bare `unsafe { ... }` statement; the spelling is `@Unsafe { ... }`
    (and `@Safe { ... }`). `unsafe` remains a reserved keyword.
  - `function` is a keyword; callable types are written `(A, B) -> R`.
*)

(* ------------------------------------------------------------------------- *)
(* Lexical                                                                   *)
(* ------------------------------------------------------------------------- *)

identifier      = identifier-start, { identifier-continue } ;
identifier-start = ascii-letter | "_" | unicode-scalar ;
identifier-continue = ascii-letter | digit | "_" | unicode-scalar ;
ascii-letter    = "A" .. "Z" | "a" .. "z" ;
digit           = "0" .. "9" ;

(* The lexer is intentionally permissive: any non-ASCII Unicode scalar that is
   not Unicode whitespace and not a control character may appear in an
   identifier. ASCII identifiers still start with a letter or underscore. *)
unicode-scalar  = ? non-ASCII Unicode scalar excluding whitespace/control ? ;

integer-literal = dec-integer | hex-integer | bin-integer | oct-integer ;
dec-integer     = digit, { digit | "_" } ;
hex-integer     = "0", ( "x" | "X" ), hex-digit, { hex-digit | "_" } ;
bin-integer     = "0", ( "b" | "B" ), bin-digit, { bin-digit | "_" } ;
oct-integer     = "0", ( "o" | "O" ), oct-digit, { oct-digit | "_" } ;
hex-digit       = digit | "a" .. "f" | "A" .. "F" ;
bin-digit       = "0" | "1" ;
oct-digit       = "0" .. "7" ;

fraction-literal = dec-integer, ".", digit, { digit | "_" },
                   [ exponent ]
                 | dec-integer, exponent ;
exponent        = ( "e" | "E" ), [ "+" | "-" ], digit, { digit } ;

character-lit   = "'", ( character | escape ), "'" ;
string-lit      = '"', { character | escape }, '"' ;
escape          = "\\", ( "n" | "r" | "t" | "0" | "\\" | "'" | '"'
                        | "u", "{", hex-digit, { hex-digit }, "}" ) ;

comment         = "//", { ? any character except newline ? }
                | "/*", { ? any character ? }, "*/" ;
doc-comment     = "///", { ? any character except newline ? }
                | "/**", { ? any character ? }, "*/" ;

(* Keywords (reserved; not available as identifiers):
   module import export as class interface implements extends annotation
   function void const static virtual override final operator where
   if else let while for switch in return break continue true false null
   this super is match extern unsafe new delete
   integer fix float record character boolean enumerate
   public private protected
   `descriptor`, `description`, `reflection`, `reflector` and `proxy` are
   ordinary identifiers, not keywords. *)

(* ------------------------------------------------------------------------- *)
(* Modules, imports and top-level declarations                               *)
(* ------------------------------------------------------------------------- *)

compilation-unit = [ module-decl ], { import-decl }, { top-level } ;
module-decl      = "module", path, ";" ;
import-decl      = "import", ( import-list | path, [ "as", identifier ] ), ";" ;
import-list      = "{", [ identifier, { ",", identifier } ], "}", "from", path ;
path             = identifier, { ".", identifier } ;

top-level        = { annotation-use }, [ "export" ],
                   ( class-decl | interface-decl | enum-decl
                   | annotation-decl | function-decl | const-decl
                   | export-list | module-directive ) ;

export-list      = "export", "{", [ identifier, { ",", identifier } ], "}", ";" ;
module-directive = ( "@Unsafe" | "@Safe" ), ";" ;   (* file-level capability *)

class-decl       = [ "final" ], "class", identifier,
                   [ generic-params ],
                   [ "extends", type ],
                   [ "implements", type, { ",", type } ],
                   class-body, [ ";" ] ;

interface-decl   = "interface", identifier, [ generic-params ],
                   [ "extends", type, { ",", type } ],
                   class-body, [ ";" ] ;

enum-decl        = "enumerate", identifier,
                   [ "implements", type, { ",", type } ],
                   "{", [ enum-variant, { ",", enum-variant }, [ "," ] ],
                   [ ";", { member-decl } ], "}", [ ";" ] ;
enum-variant     = { annotation-use }, identifier, [ "=", expression ] ;

annotation-decl  = "annotation", identifier,
                   [ "(", params, ")" | generic-params ],
                   [ "implements", type, { ",", type } ],
                   ( ";" | "{", { member-decl }, "}" ) ;

function-decl    = type, function-name, [ generic-params ], "(", params, ")",
                   [ "where", type, { ",", type } ],
                   ( block | ";" ) ;
function-name    = identifier
                 | "operator", ( identifier | operator-symbol ) ;
operator-symbol  = "+" | "-" | "*" | "/" | "%" | "==" | "!="
                 | "<" | "<=" | ">" | ">=" | "&" | "|" | "^"
                 | "<<" | ">>" | "!" | "~" | "++" | "--" ;

const-decl       = "const", ( identifier, "=", expression
                            | type, identifier, "=", expression ), ";" ;

class-body       = "{", { access-section | member-decl }, "}" ;
access-section   = ( "public" | "private" | "protected" ), ":" ;

member-decl      = { annotation-use },
                   [ "virtual" | "override" | "final" | "static" ],
                   ( constructor-decl | destructor-decl
                   | field-decl | method-decl ) ;

field-decl       = [ "final" ], type, identifier,
                   [ "=", expression ], ";" ;

method-decl      = type, identifier, [ generic-params ], "(", params, ")",
                   [ "const" ], ( block | ";" ) ;

constructor-decl = identifier, "(", params, ")",
                   [ ":", initializer, { ",", initializer } ],
                   ( block | ";" ) ;
initializer      = ( "super" | identifier ), "(", arguments, ")" ;

destructor-decl  = "~", identifier, "(", ")", ( block | ";" ) ;

(* `@Native` members of an `@Native` class are implicit; an explicit method
   annotation is rejected by Sema (E2113). *)

(* ------------------------------------------------------------------------- *)
(* Generics, types and parameters                                            *)
(* ------------------------------------------------------------------------- *)

generic-params   = "<", generic-param, { ",", generic-param }, ">" ;
generic-param    = identifier, [ "extends", type ] ;

(* Numeric representation annotations are ordinary annotations placed before
   a type expression:
     @Length(N)          storage width for integer/float/fix
     @Radix(R)           integer/float literal/print base; fix scale radix
     @Signed/@Unsigned    numeric signedness
     @Power(P)           fix scale exponent; integer/float + @Power -> fix
   They target `type`; see framework.md "Numeric Representation Annotations". *)

type             = [ "const" ], union-type, [ "&" ] ;
union-type       = intersect-type, { "|", intersect-type } ;
intersect-type   = postfix-type, { "&", postfix-type } ;
postfix-type     = primary-type, { "*" | "[", expression, "]" } ;
(* In reference positions the parser consumes the final "&" as a reference;
   elsewhere "A & B" is an intersection type. *)
primary-type     = path, [ "<", type, { ",", type }, ">" ]
                 | "(", [ type, { ",", type } ], ")", "->", type
                 | "(", type, ")" ;
                 (* `T?` is not implemented; `?` is not a type postfix. *)

params           = [ param, { ",", param } ] ;
param            = { annotation-use }, type, identifier, [ "=", expression ] ;
arguments        = [ expression, { ",", expression } ] ;

(* ------------------------------------------------------------------------- *)
(* Statements                                                                *)
(* ------------------------------------------------------------------------- *)

block            = "{", { statement }, "}" ;

statement        = block
                 | var-decl
                 | "if", "(", expression, ")", statement,
                   [ "else", statement ]
                 | "while", "(", expression, ")", statement
                 | "for", identifier, "in", expression, statement
                 | "switch", "(", expression, ")", switch-body
                 | "match", "(", expression, ")", match-body
                 | "return", [ expression ], ";"
                 | "break", ";"
                 | "continue", ";"
                 | "~", postfix-expression, ";"          (* ~this.member; *)
                 | capability-block
                 | retention-block
                 | lock-block
                 | destructure-stmt
                 | expression, ";" ;

var-decl         = { annotation-use }, [ "const" ], type, identifier,
                   [ "=", ( expression | constructure-init )
                   | brace-init
                   | "(", arguments, ")" ],
                   ";" ;
brace-init       = "{", [ expression, { ",", expression } ], "}" ;

(* @Constructure: `A value`, `A name`, `A name = expr`; type label optional. *)
constructure-init = "{", [ constructure-entry,
                           { ",", constructure-entry } ], "}" ;
constructure-entry = [ type ], ( expression
                               | identifier, [ "=", expression ] ) ;

(* Each case body is a single statement; `default` is switch-only and last. *)
switch-body      = "{", { switch-case }, "}" ;
switch-case      = "case", expression, ":", statement
                 | "default", ":", statement ;

match-body       = "{", { match-case }, "}" ;
match-case       = "case", pattern, ":", ( expression | block ) ;

pattern          = pattern-primary, { "|", pattern-primary },
                   [ "if", expression ] ;
pattern-primary  = "_"
                 | literal
                 | path
                 | literal, ( ".." | "..=" ), literal ;

capability-block = ( "@Unsafe" | "@Safe" ), block ;
retention-block  = "@Retention", "(", ( "Compile" | "Runtime" ), ")", block ;
lock-block       = "@Lock", "(", "Exclusive", ",", expression,
                   [ ",", lock-captures ], ")", block ;
lock-captures    = "[", lock-capture, { ",", lock-capture }, "]" ;
lock-capture     = identifier | "&", identifier
                 | "const", "&", identifier ;

destructure-stmt = "{", destructure-binding,
                   { ",", destructure-binding }, "}", "=", expression, ";" ;
destructure-binding = type, identifier ;

(* ------------------------------------------------------------------------- *)
(* Expressions                                                               *)
(* ------------------------------------------------------------------------- *)

expression       = if-expression | assignment-expression ;
if-expression    = "if", "(", expression, ")", expression,
                   "else", ( expression | if-expression ) ;

assignment-expression = binary-expression
                 | unary-expression, assign-op, assignment-expression ;
assign-op        = "=" | "+=" | "-=" | "*=" | "/=" | "%="
                 | "&=" | "|=" | "^=" ;

binary-expression = unary-expression,
                    { binary-op, unary-expression } ;
binary-op        = "||" | "&&" | "|" | "^" | "&"
                 | "==" | "!=" | "<" | "<=" | ">" | ">="
                 | "<<" | ">>" | "+" | "-" | "*" | "/" | "%" ;

unary-expression = ( "!" | "-" | "+" | "~" | "*" | "&" | "++" | "--" ),
                   unary-expression
                 | postfix-expression ;

postfix-expression = primary-expression,
                     { "(", arguments, ")"
                     | ".", identifier
                     | "::", identifier
                     | "[", expression, "]"
                     | ( "++" | "--" ) } ;

primary-expression = literal
                   | "this"
                   | "super", ".", identifier
                   | path
                   | "(", expression, ")"
                   | object-literal
                   | lambda-expression
                   | if-expression ;

object-literal   = "{", [ object-field, { ",", object-field } ], "}" ;
object-field     = identifier, ":", expression
                 | identifier ;

lambda-expression = [ capture-list ], "(", params, ")", ":", type,
                    "->", ( expression | block ) ;
capture-list     = "[", [ capture, { ",", capture } ], "]" ;
capture          = identifier | "&", identifier | "=" | "&" | "this" ;

literal          = integer-literal | fraction-literal
                 | character-lit | string-lit | "true" | "false" | "null" ;

(* ------------------------------------------------------------------------- *)
(* Annotations                                                               *)
(* ------------------------------------------------------------------------- *)

annotation-use   = "@", path,
                   [ "(", [ annotation-argument,
                            { ",", annotation-argument } ], ")" ] ;
annotation-argument = [ identifier, ":" ], expression ;

(* `@Native` uses named arguments:
     @Native(file: "native/include/foo.h", abi: "c++", symbol: "coo_add")
   `symbol` is function-only; a native class requires abi: "c++" and cannot
   carry `symbol`. *)
