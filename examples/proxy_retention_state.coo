@Retention(runtime)
class Trace implements ProxyHandler {
public:
    integer calls;

    @Call
    void onCall(string method) {
        calls = calls + 1;
        print(calls);
    }
}

@Proxy(Trace)
class Service {
public:
    void run() {
        print("run");
    }
}

integer main() {
    Service service;
    service.run();
    service.run();
    return 0;
}
