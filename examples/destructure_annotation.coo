class Point {
public:
    integer x;
    string y;

    Point(integer x, string y) {
        this.x = x;
        this.y = y;
    }

    @Destructure
    void unpack(integer& outX, string& outY) {
        outX = x + 1;
        outY = y + "!";
    }
}

integer main() {
    Point point(1, "a");
    {integer a, string b} = point;
    print(a);
    print(b);
    return 0;
}
