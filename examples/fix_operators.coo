integer main() {
    @Power(2) fix a = 1.5;
    @Power(2) fix b = 0.4;

    print(a + b);
    print(a - b);
    print(a * b);
    print(a / b);
    print(a % b);
    print(-a);
    print(a > b);

    print(a & b);
    print(a | b);
    print(a ^ b);
    print(~a);
    print(a << 1);
    print(a >> 1);

    a++;
    print(a);
    ++a;
    print(a);
    a--;
    print(a);
    return 0;
}
